<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Riyadh.master.cs" Inherits="Riyadh_Al_Salehin.Riyadh" %>

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>نظام إدارة مستشفى الرياض الصالحين</title>
    <meta name="description" content="">
    <meta name="keywords" content="">

    <!-- Favicons -->
    <link href="assets/img/favicon.png" rel="icon">
    <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="assets/css/main.css" rel="stylesheet">

    <style>
        /* ============================================================
                   RESET & BASE
                   ============================================================ */
        body {
            font-family: 'Cairo', 'Roboto', sans-serif;
            background: #f4f8fc;
            direction: rtl;
        }

        /* ============================================================
                   HEADER (ثابت)
                   ============================================================ */
        .header {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            background: #ffffff;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 9999;
            transition: all 0.3s ease;
        }

        /* -------- الشريط العلوي (TOP BAR) -------- */
        .top-header {
            background: linear-gradient(135deg, #0b2b4a 0%, #1a4a7a 100%);
            color: #fff;
            padding: 8px 0;
            font-size: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(4px);
        }

        .top-header .system-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 0.5px;
        }

        .top-header .system-title i {
            font-size: 22px;
            color: #7fc9ff;
        }

        /* Logo image inside top header (system title) */
        .top-header .system-title .system-logo {
            width: 34px;
            height: 34px;
            object-fit: cover;
            border-radius: 6px;
            display: inline-block;
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        }

        /* also target logo-img used on other places */
        .top-header .system-title .logo-img {
            width: 34px;
            height: 34px;
            object-fit: cover;
            border-radius: 6px;
            display: inline-block;
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        }

        @media (max-width: 576px) {
            .top-header .system-title .system-logo {
                width: 26px;
                height: 26px;
            }
            .top-header .system-title {
                font-size: 14px;
            }
        }

        .top-header .top-right {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .top-header .clock {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.12);
            padding: 4px 14px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
        }

        .top-header .clock i {
            font-size: 18px;
            color: #7fc9ff;
        }

        .top-header .top-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .top-header .top-actions a {
            color: rgba(255, 255, 255, 0.8);
            transition: 0.3s;
            font-size: 18px;
            position: relative;
        }

        .top-header .top-actions a:hover {
            color: #ffffff;
            transform: scale(1.1);
        }

        .top-header .top-actions .badge-dot {
            position: absolute;
            top: -4px;
            right: -6px;
            width: 10px;
            height: 10px;
            background: #ff4d4d;
            border-radius: 50%;
            border: 2px solid #0b2b4a;
        }

        /* -------- الهيدر الرئيسي (BRANDING) -------- */
        .branding {
            padding: 12px 0;
            background: #ffffff;
            border-bottom: 1px solid #eef2f7;
        }

        /* اللوجو */
        .logo {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 14px;
        }

        .logo .logo-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #0d6efd, #0b2b4a);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 28px;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        }
        .logo .logo-img {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            object-fit: cover;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
            display: block;
        }

        .logo .logo-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .logo .logo-title {
            font-size: 24px;
            font-weight: 800;
            color: #0b2b4a;
            letter-spacing: -0.5px;
        }

        .logo .logo-sub {
            font-size: 13px;
            color: #6c7a8a;
            font-weight: 500;
            letter-spacing: 1px;
        }

        /* -------- القائمة الرئيسية -------- */
        #navmenu {
            flex: 1;
            display: flex;
            justify-content: center;
        }

        #navmenu>ul {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        #navmenu>ul>li {
            list-style: none;
            position: relative;
        }

        #navmenu>ul>li>a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            font-size: 15px;
            font-weight: 700;
            color: #1f2a3a;
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.25s ease;
            white-space: nowrap;
            position: relative;
        }

        #navmenu>ul>li>a i {
            font-size: 18px;
            color: #6c7a8a;
        }

        #navmenu>ul>li>a:hover,
        #navmenu>ul>li>a.active {
            background: #f0f5ff;
            color: #0d6efd;
            box-shadow: 0 2px 8px rgba(13, 110, 253, 0.12);
        }

        #navmenu>ul>li>a:hover i,
        #navmenu>ul>li>a.active i {
            color: #0d6efd;
        }

        .toggle-dropdown {
            font-size: 12px;
            margin-right: 4px;
            transition: 0.3s;
        }

        #navmenu>ul>li.dropdown:hover .toggle-dropdown {
            transform: rotate(180deg);
        }

        /* ===== Dropdown محسّن ===== */
        #navmenu ul li.dropdown {
            position: relative;
        }

        /* جسر الفجوة بين العنصر والقائمة */
        #navmenu ul li.dropdown::before {
            content: '';
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            height: 12px;
            background: transparent;
            z-index: 9998;
        }

        #navmenu ul li.dropdown ul {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 240px;
            background: #ffffff;
            border-radius: 16px;
            padding: 10px 0;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
            z-index: 9999;
            list-style: none;
            margin: 0;
            border: 1px solid #eef2f7;

            /* استبدال display بـ opacity/visibility للـ transition */
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
            pointer-events: none; /* منع التفاعل وهي مخفية */
        }

        #navmenu ul li.dropdown:hover ul {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease;
            pointer-events: auto; /* تفعيل التفاعل */
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        #navmenu ul li.dropdown ul li a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 600;
            color: #2c3e50;
            text-decoration: none;
            transition: 0.2s;
        }

        #navmenu ul li.dropdown ul li a i {
            font-size: 16px;
            color: #6c7a8a;
        }

        #navmenu ul li.dropdown ul li a:hover {
            background: #f0f5ff;
            color: #0d6efd;
            padding-right: 28px;
        }

        #navmenu ul li.dropdown ul li a:hover i {
            color: #0d6efd;
        }

        /* -------- منطقة المستخدم -------- */
        .user-box {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
            padding-right: 20px;
            border-right: 1px solid #eef2f7;
        }

        .user-box .user-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d6efd, #0b2b4a);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 22px;
            box-shadow: 0 2px 10px rgba(13, 110, 253, 0.25);
        }

        .user-box .user-details {
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }

        .user-box .user-name {
            font-size: 15px;
            font-weight: 700;
            color: #0b2b4a;
        }

        .user-box .user-role {
            font-size: 12px;
            color: #8a9aa8;
            font-weight: 500;
        }

        .user-box .logout-link {
            color: #dc3545;
            font-size: 20px;
            transition: 0.3s;
            text-decoration: none;
            padding: 4px;
            border-radius: 50%;
        }

        .user-box .logout-link:hover {
            background: #ffebee;
            transform: scale(1.1);
        }

        /* -------- زر القائمة للجوال -------- */
        .mobile-nav-toggle {
            display: none;
            font-size: 28px;
            color: #0b2b4a;
            cursor: pointer;
            transition: 0.3s;
            padding: 4px 8px;
            border-radius: 8px;
        }

        .mobile-nav-toggle:hover {
            background: #f0f5ff;
        }

        /* -------- Offcanvas (القائمة الجانبية) -------- */
        .offcanvas {
            direction: rtl;
            font-family: 'Cairo', sans-serif;
        }

        .offcanvas-header {
            border-bottom: 1px solid #eef2f7;
        }

        .offcanvas-body ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .offcanvas-body ul li {
            border-bottom: 1px solid #f5f7fa;
        }

        .offcanvas-body ul li a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            font-size: 16px;
            font-weight: 600;
            color: #1f2a3a;
            text-decoration: none;
            transition: 0.2s;
            border-radius: 10px;
        }

        .offcanvas-body ul li a:hover {
            background: #f0f5ff;
            color: #0d6efd;
        }

        .offcanvas-body ul li a i {
            font-size: 20px;
            color: #6c7a8a;
        }

        .offcanvas-body ul li.dropdown-menu-offcanvas {
            padding-right: 30px;
        }

        .offcanvas-body ul li.dropdown-menu-offcanvas a {
            font-weight: 400;
            font-size: 14px;
        }

        /* ============================================================
                   RESPONSIVE
                   ============================================================ */
        @media (max-width: 1200px) {
            .logo .logo-title {
                font-size: 20px;
            }
            #navmenu>ul>li>a {
                font-size: 13px;
                padding: 8px 12px;
            }
        }

        @media (max-width: 991px) {
            #navmenu {
                display: none;
            }

            .mobile-nav-toggle {
                display: block;
            }

            .user-box .user-details {
                display: none;
            }

            .user-box {
                border-right: none;
                padding-right: 0;
                gap: 8px;
            }

            .user-box .user-avatar {
                width: 38px;
                height: 38px;
                font-size: 18px;
            }

            .top-header .system-title span {
                display: none;
            }

            .top-header .clock span {
                display: none;
            }

            .top-header .top-right {
                gap: 12px;
            }
        }

        @media (max-width: 576px) {
            .logo .logo-title {
                font-size: 16px;
            }
            .logo .logo-sub {
                font-size: 10px;
            }
            .logo .logo-icon {
                width: 40px;
                height: 40px;
                font-size: 20px;
            }
            .branding {
                padding: 8px 0;
            }
            .top-header {
                font-size: 12px;
                padding: 4px 0;
            }
            .top-header .clock {
                padding: 2px 10px;
                font-size: 12px;
            }
        }

        /* تحسين احترافي للهاتف فقط */
        @media (max-width: 767.98px) {
            body {
                overflow-x: hidden;
            }

            .header {
                width: 100%;
                min-height: 0;
            }

            .top-header {
                display: block;
                padding: 6px 0;
                min-height: 38px;
            }

            .top-header .container-fluid,
            .branding .container-fluid {
                padding-left: 12px !important;
                padding-right: 12px !important;
            }

            .top-header .d-flex {
                min-height: 26px;
                gap: 8px;
            }

            .top-header .system-title {
                min-width: 0;
                gap: 6px;
                font-size: .78rem;
                white-space: nowrap;
            }

            .top-header .system-title i {
                flex: 0 0 auto;
                font-size: 16px;
            }

            .top-header .system-title span {
                display: block;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .top-header .top-right {
                flex: 0 0 auto;
                gap: 7px;
            }

            .top-header .clock {
                gap: 4px;
                padding: 3px 7px;
                font-size: .7rem;
                white-space: nowrap;
            }

            .top-header .clock i {
                font-size: 13px;
            }

            .top-header .top-actions {
                gap: 7px;
            }

            .top-header .top-actions a {
                font-size: 16px;
            }

            .branding {
                padding: 9px 0;
            }

            .branding > .container-fluid > .d-flex {
                gap: 8px;
            }

            .logo {
                min-width: 0;
                flex: 1 1 auto;
                gap: 8px;
            }

            .logo .logo-icon {
                width: 38px;
                height: 38px;
                flex: 0 0 38px;
                border-radius: 11px;
                font-size: 19px;
            }

            .logo .logo-text {
                min-width: 0;
            }

            .logo .logo-title {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-size: .88rem;
            }

            .logo .logo-sub {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-size: .58rem;
                letter-spacing: .3px;
            }

            .user-box {
                flex: 0 0 auto;
                gap: 5px;
            }

            .user-box .user-avatar {
                width: 34px;
                height: 34px;
                font-size: 16px;
            }

            .user-box .logout-link {
                font-size: 18px;
            }

            .mobile-nav-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
                flex: 0 0 42px;
                width: 42px;
                height: 42px;
                padding: 0;
                border: 1px solid #dce7f5;
                background: #f7faff;
                color: #0d6efd;
                font-size: 24px;
            }

            .page-content-wrapper {
                padding-top: 112px;
                padding-bottom: 24px;
            }

            .offcanvas {
                width: min(86vw, 350px) !important;
                border-left: 0;
                box-shadow: -8px 0 30px rgba(11, 43, 74, .18);
            }

            .offcanvas-header {
                padding: 16px;
                background: linear-gradient(135deg, #0b2b4a, #1a4a7a);
                color: #fff;
            }

            .offcanvas-title {
                font-size: 1.05rem;
                font-weight: 700;
            }

            .offcanvas-header .btn-close {
                filter: brightness(0) invert(1);
                opacity: .9;
            }

            .offcanvas-body {
                padding: 12px;
                background: #fbfdff;
            }

            .offcanvas-body > ul > li {
                margin-bottom: 6px;
                border: 1px solid #edf2f7;
                border-radius: 10px;
                background: #fff;
                overflow: hidden;
            }

            .offcanvas-body > ul > li > a {
                min-height: 48px;
                padding: 12px 14px;
                font-size: .95rem;
            }

            .offcanvas-body ul li.mobile-menu-section {
                padding: 0;
            }

            .offcanvas-body .mobile-menu-title {
                padding: 12px 14px 7px;
                color: #0b2b4a;
                font-size: .95rem;
                font-weight: 800;
            }

            .offcanvas-body .mobile-menu-section > ul {
                padding: 0 8px 8px;
            }

            .offcanvas-body .mobile-menu-section > ul > li {
                border-top: 1px solid #f0f3f7;
            }

            .offcanvas-body .mobile-menu-section > ul > li > a {
                padding: 10px 8px;
                font-size: .88rem;
            }
        }

        /* ============================================================
                   UTILITY: مسافة للهيدر الثابت
                   ============================================================ */
        .page-content-wrapper {
            padding-top: 140px;
            padding-bottom: 40px;
        }

        @media (max-width: 991px) {
            .page-content-wrapper {
                padding-top: 120px;
            }
        }

        @media (max-width: 576px) {
            .page-content-wrapper {
                padding-top: 100px;
            }
        }

        /* ============================================================
                   تأثير التمرير (اختياري)
                   ============================================================ */
        .header.scrolled {
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
        }

        /* شريط تقدم (إضافة بسيطة) */
        .progress-bar-custom {
            height: 3px;
            background: linear-gradient(90deg, #0d6efd, #7fc9ff);
            width: 0%;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 99999;
            transition: width 0.2s;
        }

        /* ============================================================
           تحسين عام لجميع الصفحات على الهاتف فقط
           ============================================================ */
        @media (max-width: 767.98px) {
            html,
            body {
                max-width: 100%;
                overflow-x: hidden;
            }

            .main,
            #form1,
            .page-content-wrapper {
                max-width: 100%;
                min-width: 0;
            }

            .page-content-wrapper {
                padding-left: 10px !important;
                padding-right: 10px !important;
                padding-top: 112px;
            }

            .page-content-wrapper > .container,
            .page-content-wrapper > .container-fluid,
            #form1 > .container,
            #form1 > .container-fluid {
                width: 100%;
                max-width: 100%;
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

            .row {
                --bs-gutter-x: .75rem;
                --bs-gutter-y: .75rem;
            }

            .card,
            .card-body,
            .panel,
            .well,
            .jumbotron {
                max-width: 100%;
            }

            .card-body,
            .panel-body {
                padding: 14px;
            }

            h1 {
                font-size: 1.45rem;
            }

            h2 {
                font-size: 1.3rem;
            }

            h3 {
                font-size: 1.15rem;
            }

            h4 {
                font-size: 1.05rem;
            }

            h5 {
                font-size: .98rem;
            }

            .form-control,
            .form-select,
            .input-group-text,
            select,
            input[type="text"],
            input[type="number"],
            input[type="date"],
            input[type="time"],
            input[type="email"],
            input[type="tel"],
            input[type="password"] {
                max-width: 100%;
                min-height: 42px;
                font-size: .92rem;
            }

            textarea.form-control,
            textarea {
                min-height: 88px;
                font-size: .92rem;
            }

            .btn,
            input[type="submit"],
            input[type="button"] {
                min-width: 0;
                max-width: 100%;
                min-height: 42px;
                padding: 8px 12px;
                font-size: .88rem;
                white-space: normal;
                line-height: 1.35;
            }

            .btn-group,
            .btn-toolbar {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
            }

            .btn-group > .btn,
            .btn-toolbar > .btn {
                flex: 1 1 auto;
            }

            /* الجداول: الحفاظ على كامل البيانات مع تمرير أفقي */
            .table-responsive,
            .table-wrapper,
            .table-container,
            .grid-container,
            .tableCard {
                width: 100%;
                max-width: 100%;
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch;
            }

            .table-responsive > .table,
            .table-wrapper > table,
            .table-container > table,
            .grid-container > table,
            .tableCard > table {
                margin-bottom: 0;
                white-space: nowrap;
            }

            table.table,
            table.grid {
                font-size: .8rem;
            }

            table.table th,
            table.table td,
            table.grid th,
            table.grid td {
                padding: 7px 8px;
                vertical-align: middle;
            }

            img,
            video,
            iframe {
                max-width: 100%;
                height: auto;
            }

            .modal-dialog {
                width: auto;
                max-width: calc(100% - 20px);
                margin: 10px auto;
            }

            .modal-body {
                max-height: 70vh;
                overflow-y: auto;
            }

            .alert,
            .validation-summary-errors {
                font-size: .85rem;
                line-height: 1.7;
                overflow-wrap: anywhere;
            }

            .page-content-wrapper .d-flex {
                flex-wrap: wrap;
            }
        }
    </style>
<style>
    /* Loader (From Uiverse.io by csemszepp) */
    .page-loader {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        /* use a semi-dark overlay so the white center circle is visible */
        background: rgba(0,0,0,0.55);
        z-index: 10500;
    }

    .page-loader .loader {
        width: 140px;
        height: 140px;
    }

    .loader {
      width: 200px;
      max-height: 900px;
      transform-origin: 50% 50%;
      overflow: visible;
    }

    .ci1 {
      /* explicit visible color if --higru is not defined */
      fill: #0d6efd;
      animation: toBig 3s infinite -1.5s;
      transform-box: fill-box;
      transform-origin: 50% 50%;
    }

    .ciw {
      transform-box: fill-box;
      transform-origin: 50% 50%;
      animation: breath 3s infinite;
    }

    .ci2 {
      fill: #0d6efd;
      animation: toBig2 3s infinite;
      transform-box: fill-box;
      transform-origin: 50% 50%;
    }

    /* Fade-out helper used by script */
    .page-loader.fade-out {
        opacity: 0;
        transition: opacity 0.45s ease;
        pointer-events: none;
    }

    .points {
      animation: rot 3s infinite;
      transform-box: fill-box;
      transform-origin: 50% 50%;
    }

    @keyframes rot {
      0% {
        transform: rotate(0deg);
      }

      30% {
        transform: rotate(360deg);
      }

      50% {
        transform: rotate(360deg);
      }

      80% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(0deg);
      }
    }

    @keyframes toBig {
      0% {
        transform: scale(1) translateX(0px);
      }

      30% {
        transform: scale(1) translateX(0px);
      }

      50% {
        transform: scale(10) translateX(-4.5px);
      }

      80% {
        transform: scale(10) translateX(-4.5px);
      }

      100% {
        transform: scale(1) translateX(0px);
      }
    }

    @keyframes toBig2 {
      0% {
        transform: scale(1) translateX(0px);
      }

      30% {
        transform: scale(1) translateX(0px);
      }

      50% {
        transform: scale(10) translateX(4.5px);
      }

      80% {
        transform: scale(10) translateX(4.5px);
      }

      100% {
        transform: scale(1) translateX(0px);
      }
    }

    @keyframes breath {
      15% {
        transform: scale(1);
      }

      40% {
        transform: scale(1.1);
      }

      65% {
        transform: scale(1);
      }

      90% {
        transform: scale(1.1);
      }
    }

    .dwf, .share {
      position: fixed;
      bottom: 4px;
      right: 10px;
      background-color: #0003;
      padding: 3px;
      border-radius: 3px;
    }
</style>
</head>

<body>

    <!-- Page Loader -->
    <div id="pageLoader" class="page-loader" role="status" aria-label="Loading">
        <svg viewBox="0 0 100 100" class="loader" aria-hidden="true">
            <g class="points">
              <circle fill="#fff" r="50" cy="50" cx="50" class="ciw"></circle>
            <circle r="4" cy="50" cx="5" class="ci2"></circle>
            <circle r="4" cy="50" cx="95" class="ci1"></circle>
            </g>
        </svg>
    </div>

    <!-- شريط تقدم (اختياري) -->
    <div class="progress-bar-custom" id="progressBar"></div>

    <header id="header" class="header">

        <!-- ====== الشريط العلوي ====== -->
        <div class="top-header">
            <div class="container-fluid px-4">
                <div class="d-flex justify-content-between align-items-center">

                    <div class="system-title">
                        <img src="IMG/RD.jpg" alt="Logo" class="logo-img bi bi-hospital-fill " />
                        <%--<i class="bi bi-hospital-fill"></i>--%>
                        <span>نظام إدارة مستشفى الرياض الصالحين</span>
                    </div>

                    <div class="top-right">
                        <div class="clock">
                            <i class="bi bi-clock-history"></i>
                            <asp:Label ID="lblDate" runat="server"></asp:Label>
                        </div>

                        <div class="top-actions">
                            <a href="#" title="إشعارات">
                                <i class="bi bi-bell"></i>
                                <span class="badge-dot"></span>
                            </a>
                            <a href="#" title="مساعدة">
                                <i class="bi bi-question-circle"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ====== الهيدر الرئيسي ====== -->
        <div class="branding">
            <div class="container-fluid px-4">
                <div class="d-flex align-items-center justify-content-between">

                    <!-- اللوجو -->
                    <a href="Dashboard.aspx" class="logo">



                        <img src="IMG/RD.jpg" alt="Logo" class="logo-img" />
                        <div class="logo-text">
                            <span class="logo-title">مستشفى الرياض الصالحين</span>
                            <span class="logo-sub">Hospital Management System</span>
                        </div>
                    </a>

                    <!-- القائمة الرئيسية (Desktop) -->
                    <nav id="navmenu">
                        <ul id="menuItems" runat="server">
                            <!-- سيتم تعبئتها من الخادم -->
                        </ul>
                    </nav>

                    <!-- منطقة المستخدم -->
                    <div class="user-box">
                        <div class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="user-details">
                            <asp:Label ID="lblUserName" runat="server" CssClass="user-name"></asp:Label>
                            <asp:Label ID="lblRole" runat="server" CssClass="user-role"></asp:Label>
                        </div>
                        <a href="Login.aspx" class="logout-link" title="تسجيل الخروج">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>

                    <!-- زر القائمة للجوال -->
                    <div class="mobile-nav-toggle" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu" aria-controls="offcanvasMenu">
                        <i class="bi bi-list"></i>
                    </div>

                </div>
            </div>
        </div>

    </header>

    <!-- ====== قائمة الجوال (Offcanvas) ====== -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="offcanvasMenuLabel">
                <i class="bi bi-hospital-fill text-primary"></i> القائمة
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <ul id="mobileMenuItems" runat="server">
                <!-- سيتم تعبئتها من الخادم بنفس هيكل القائمة ولكن بشكل متوافق مع الجوال -->
            </ul>
        </div>
    </div>

    <!-- ====== المحتوى الرئيسي ====== -->
    <main class="main">
        <div class="container-fluid px-4 page-content-wrapper">
            <form id="form1" runat="server" enctype="multipart/form-data">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </form>
        </div>
    </main>

    <!-- ====== الفوتر ====== -->
    <footer id="footer" class="footer-16 footer position-relative">
        <div class="container">
            <div class="footer-main" data-aos="fade-up" data-aos-delay="100">
                <div class="row align-items-start">
                    <!-- محتوى الفوتر (يمكنك إضافته) -->
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <div class="bottom-content" data-aos="fade-up" data-aos-delay="300">
                    <!-- محتوى الفوتر السفلي -->
                </div>
            </div>
        </div>
    </footer>

    <!-- ====== سكربتات ====== -->
    <script src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="assets/vendor/php-email-form/validate.js"></script>
    <script src="assets/vendor/aos/aos.js"></script>
    <script src="assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="assets/js/main.js"></script>
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

    <script>
// تفعيل AOS
AOS.init({
    duration: 800,
    once: true
});

// شريط التقدم عند التمرير
window.addEventListener('scroll', function () {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    document.getElementById('progressBar').style.width = scrolled + '%';
});

// تأثير ظل الهيدر عند التمرير
window.addEventListener('scroll', function () {
    const header = document.querySelector('.header');
    if (window.scrollY > 50) {
        header.classList.add('scrolled');
    } else {
        header.classList.remove('scrolled');
    }
});

// ===== استقرار القوائم المنسدلة =====
document.addEventListener('DOMContentLoaded', function () {
    const dropdowns = document.querySelectorAll('#navmenu ul li.dropdown');
    let timeoutId;

    dropdowns.forEach(function (dropdown) {
        const menu = dropdown.querySelector('ul');
        if (!menu) return;

        dropdown.addEventListener('mouseenter', function () {
            clearTimeout(timeoutId);
            menu.style.opacity = '1';
            menu.style.visibility = 'visible';
            menu.style.transform = 'translateY(0)';
            menu.style.pointerEvents = 'auto';
        });

        dropdown.addEventListener('mouseleave', function (e) {
            // تأخير الاختفاء 300 مللي ثانية
            timeoutId = setTimeout(function () {
                menu.style.opacity = '0';
                menu.style.visibility = 'hidden';
                menu.style.transform = 'translateY(8px)';
                menu.style.pointerEvents = 'none';
            }, 300);
        });

        // عند دخول المؤشر للقائمة نفسها، ألغِ الاختفاء
        menu.addEventListener('mouseenter', function () {
            clearTimeout(timeoutId);
        });

        menu.addEventListener('mouseleave', function () {
            timeoutId = setTimeout(function () {
                menu.style.opacity = '0';
                menu.style.visibility = 'hidden';
                menu.style.transform = 'translateY(8px)';
                menu.style.pointerEvents = 'none';
            }, 300);
        });
    });
});
</script>

<script>
    // Hide page loader when page finishes loading (with fallback) - fade then remove
    (function () {
        var loader = document.getElementById('pageLoader');
        if (!loader) return;

        function hideLoader() {
            try {
                if (!loader.classList.contains('fade-out')) {
                    loader.classList.add('fade-out');
                    // remove from flow after fade completes
                    setTimeout(function () { try { loader.style.display = 'none'; } catch (e) { } }, 500);
                }
            } catch (e) { /* ignore */ }
        }

        if (document.readyState === 'complete') {
            hideLoader();
        } else {
            window.addEventListener('load', hideLoader);
        }

        // Safety: force hide after 8s if load doesn't fire
        setTimeout(hideLoader, 8000);
    })();
</script>

</body>

</html>